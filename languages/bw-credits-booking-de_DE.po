#. Label of the booking button
#: catalogue:booking.button.book
msgid "Book course (1 credit)"
msgstr "Kurs buchen (1 Credit)"

#. Label shown when the session is booked
#: catalogue:booking.button.cancel
msgid "Cancel booking"
msgstr "Buchung stornieren"

#. Short label in the booking list
#: catalogue:booking.button.cancel_short
msgid "Cancel"
msgstr "Stornieren"

#. Note for visitors who are not logged in
#: catalogue:booking.note.login
msgid "Please log in to book."
msgstr "Bitte einloggen um zu buchen."

#. The session is in the past
#: catalogue:booking.note.past
msgid "This session is over."
msgstr "Dieser Termin ist vorbei."

#. No spots left
#: catalogue:booking.note.full
msgid "This session is fully booked."
msgstr "Dieser Termin ist ausgebucht."

#. Booked, but the cancellation deadline has passed
#: catalogue:booking.note.booked
msgid "You are booked for this session."
msgstr "Du bist für diesen Termin angemeldet."

#. Credit balance used up, shown before the top-up link — also fits customers with no prior booking
#: catalogue:booking.note.no_credits
msgid "You have no credits."
msgstr "Du hast keine Credits."

#. Label of the link to the shop page
#: catalogue:booking.link.topup
msgid "Top up now"
msgstr "Jetzt aufladen"

#. Placeholder {free} is replaced with the number — up to the threshold from the settings
#: catalogue:availability.free
msgid "{free} spots available"
msgstr "{free} freie Plätze"

#. Used from the settings threshold onward instead of the exact number
#: catalogue:availability.more_than
msgid "more than {n} spots available"
msgstr "mehr als {n} Plätze frei"

#. When no spots are left
#: catalogue:availability.full
msgid "Fully booked"
msgstr "Ausgebucht"

#. Label before the number
#: catalogue:balance.label
msgid "Available credits:"
msgstr "Verfügbare Credits:"

#. Note shown at zero credits
#: catalogue:balance.empty
msgid "Your credit balance is used up."
msgstr "Dein Guthaben ist aufgebraucht."

#. Singular form in the account overview
#: catalogue:balance.count.one
msgid "credit available"
msgstr "Credit verfügbar"

#. Plural form in the account overview
#: catalogue:balance.count.many
msgid "credits available"
msgstr "Credits verfügbar"

#. When no credits are available
#: catalogue:credits.empty
msgid "You currently have no credits."
msgstr "Du hast aktuell kein Guthaben."

#. Origin: bought through the shop
#: catalogue:credits.source.purchase
msgid "Purchase"
msgstr "Kauf"

#. Origin: from a membership
#: catalogue:credits.source.membership
msgid "Membership"
msgstr "Mitgliedschaft"

#. Origin: manually credited
#: catalogue:credits.source.manual
msgid "Manual credit"
msgstr "Gutschrift"

#. Status of an expired credit
#: catalogue:credits.expired
msgid "expired"
msgstr "abgelaufen"

#. Credit without an expiry date
#: catalogue:credits.unlimited
msgid "valid indefinitely"
msgstr "unbegrenzt gültig"

#. Credit with an expiry date
#: catalogue:credits.valid_until
msgid "valid until {date}"
msgstr "gültig bis {date}"

#. Empty booking list
#: catalogue:bookings.empty
msgid "No bookings yet."
msgstr "Noch keine Buchungen vorhanden."

#. Booking list for visitors who are not logged in
#: catalogue:bookings.login_required
msgid "Please log in."
msgstr "Bitte einloggen."

#. Status of an active booking
#: catalogue:bookings.status.booked
msgid "Booked"
msgstr "Gebucht"

#. Status of a cancelled booking
#: catalogue:bookings.status.cancelled
msgid "Cancelled"
msgstr "Storniert"

#. Interim status while booking is in progress
#: catalogue:bookings.status.pending
msgid "Pending"
msgstr "Ausstehend"

#. Marked by the studio as a no-show
#: catalogue:bookings.status.no_show
msgid "No-show"
msgstr "Nicht erschienen"

#. No sessions found
#: catalogue:course_list.empty
msgid "No sessions are currently scheduled."
msgstr "Aktuell sind keine Termine geplant."

#. First option in the filter dropdowns
#: catalogue:course_list.filter.all
msgid "All"
msgstr "Alle"

#. Button in the filter form
#: catalogue:course_list.filter.submit
msgid "Filter"
msgstr "Filtern"

#. Link to clear the filters
#: catalogue:course_list.filter.reset
msgid "Reset"
msgstr "Zurücksetzen"

#. Label of the filter for course_type
#: catalogue:course_list.filter.type
msgid "Course type"
msgstr "Kursart"

#. Label of the filter for course_level
#: catalogue:course_list.filter.level
msgid "Level"
msgstr "Level"

#. Label of the filter for course_lang
#: catalogue:course_list.filter.lang
msgid "Language"
msgstr "Sprache"

#. Heading above the meeting link and notes
#: catalogue:access.title
msgid "Access details"
msgstr "Zugangsdaten"

#. Label of the meeting link
#: catalogue:access.link
msgid "Join online session"
msgstr "Zum Online-Kurs"

#. Heading above the booking list in the account
#: catalogue:overview.heading.courses
msgid "My courses"
msgstr "Meine Kurse"

#. Heading above the course list in the account
#: catalogue:overview.upcoming.label
msgid "Upcoming courses"
msgstr "Kommende Kurse"

#. Link to the session list
#: catalogue:overview.link.courses
msgid "View course sessions"
msgstr "Kurstermine ansehen"

#. Link to the WooCommerce orders
#: catalogue:overview.link.orders
msgid "My orders"
msgstr "Meine Bestellungen"

#. Link to the shop page
#: catalogue:overview.link.topup
msgid "Top up credits"
msgstr "Guthaben aufladen"

#. Booking attempt with no credits available
#: catalogue:error.no_credits
msgid "You don't have any credits left."
msgstr "Du hast kein Guthaben mehr."

#. Booking attempt for a past session
#: catalogue:error.slot_past
msgid "This session is in the past."
msgstr "Dieser Termin liegt in der Vergangenheit."

#. Duplicate booking
#: catalogue:error.already_booked
msgid "You have already booked this session."
msgstr "Du hast diesen Termin bereits gebucht."

#. Cancellation of an unknown booking
#: catalogue:error.booking_not_found
msgid "Booking not found."
msgstr "Buchung nicht gefunden."

#. Cancellation of an already-cancelled booking
#: catalogue:error.not_active
msgid "This booking has already been cancelled."
msgstr "Diese Buchung ist bereits storniert."

#. Cancellation attempt after the deadline
#: catalogue:error.cutoff_passed
msgid "The cancellation deadline has passed."
msgstr "Die Stornofrist ist abgelaufen."

#. Session is missing or not published
#: catalogue:error.slot_invalid
msgid "This session is not available."
msgstr "Dieser Termin ist nicht verfügbar."

#. Capacity is missing or zero
#: catalogue:error.capacity_missing
msgid "No capacity is set for this session."
msgstr "Für diesen Termin ist keine Kapazität hinterlegt."

#. start_datetime not set
#: catalogue:error.slot_time_missing
msgid "This session is missing a start time."
msgstr "Für diesen Termin fehlt die Startzeit."

#. Concurrent access, retry needed
#: catalogue:error.retry
msgid "That didn't work. Please try again."
msgstr "Das hat nicht geklappt. Bitte versuche es noch einmal."

#. Unexpected error while booking or cancelling
#: catalogue:error.generic
msgid "The action could not be completed."
msgstr "Die Aktion konnte nicht ausgeführt werden."

#. Heading in the WooCommerce order email when credits were added
#: catalogue:order_email.heading
msgid "Your credit balance has been topped up"
msgstr "Dein Guthaben wurde aufgeladen"

#. Text in the WooCommerce order email, right after the order summary
#: catalogue:order_email.body
msgid "{credits_added} credits have been added to your account. Current balance: {credits_remaining}.\n\nManage your credits and bookings here: {account_link}"
msgstr "{credits_added} Credits wurden deinem Konto gutgeschrieben. Aktuelles Guthaben: {credits_remaining}.\n\nHier verwaltest du dein Guthaben und deine Buchungen: {account_link}"

