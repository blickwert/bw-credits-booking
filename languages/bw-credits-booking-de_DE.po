#: email:booking.body
msgid "Greetings {first_name} 🌿,\n\nYour class has been successfully booked! ✨\n\nI’m looking forward to welcoming you and sharing this practice with you. 🤍\n\n<strong>Class Details 🧘‍♀️</strong>\nDate: {date}\nTime: {time}\nClass Type: {course_type}\nLevel: {course_level}\n\nYou can view, manage or cancel your booking anytime in your account: {account_link}\n{cancel_note}\n\n{access_timing}, you will receive the Zoom link along with all additional details needed to join the session. 💻✨\n\nIf you do not receive this email or if you experience any issues accessing the class, please feel free to contact me at {contact_email}. I’ll be happy to assist you. 🌱\n\nI look forward to seeing you on the mat soon. 🤍\n\nWith warmth,\nHelena 🌸"
msgstr "Hallo {first_name} 🌿,\n\ndeine Klasse wurde erfolgreich gebucht! ✨\n\nIch freue mich darauf, dich willkommen zu heißen und diese Praxis mit dir zu teilen. 🤍\n\n<strong>Klassendetails 🧘‍♀️</strong>\nDatum: {date}\nUhrzeit: {time}\nArt der Klasse: {course_type}\nLevel: {course_level}\n\nDu kannst deine Buchung jederzeit in deinem Konto ansehen, verwalten oder stornieren: {account_link}\n{cancel_note}\n\n{access_timing} erhältst du den Zoom-Link sowie alle weiteren Informationen, die du benötigst, um an der Sitzung teilzunehmen. 💻✨\n\nFalls du diese E-Mail nicht erhältst oder Schwierigkeiten beim Zugang zur Klasse hast, kannst du dich jederzeit unter {contact_email} bei mir melden. Ich helfe dir gerne weiter. 🌱\n\nIch freue mich darauf, dich bald auf der Matte zu sehen. 🤍\n\nMit Wärme,\nHelena 🌸"

#. Name of the time zone next to session times ({city} = city of the site time zone, Settings → General)
#: catalogue:time.zone_label
msgid "{city} time"
msgstr "{city}-Zeit"

#. The customer's own time in emails, shown when it differs from the session time
#: catalogue:time.local
msgid "{time} in your time zone ({zone})"
msgstr "{time} in deiner Zeitzone ({zone})"

#. Cancellation rule next to the booking button and in the confirmation email ({deadline} = date, time and time zone)
#: catalogue:booking.cancel_until
msgid "You can cancel until {deadline}; your credit is refunded."
msgstr "Du kannst bis {deadline} stornieren, dein Guthaben wird dir gutgeschrieben."

#. Shown for a booking whose cancellation deadline has passed
#: catalogue:booking.cancel_closed
msgid "Cancellation is no longer possible (less than {hours} hours before the start)."
msgstr "Eine Stornierung ist nicht mehr möglich (weniger als {hours} Stunden vor Beginn)."

#. Shown before booking a session that starts within the cancellation deadline
#: catalogue:booking.cancel_late_hint
msgid "If you book now, you can no longer cancel (less than {hours} hours before the start)."
msgstr "Wenn du jetzt buchst, ist keine Stornierung mehr möglich (weniger als {hours} Stunden vor Beginn)."

#: includes/time-zone.php:164
msgid "Time zone"
msgstr "Zeitzone"

#: includes/time-zone.php:166
msgid "Automatic (from your browser)"
msgstr "Automatisch (aus deinem Browser)"

#: includes/time-zone.php:173
msgid "Session times are shown in your time zone too — on the website and in emails."
msgstr "Kurszeiten werden dir auch in deiner Zeitzone angezeigt — auf der Website und in E-Mails."

