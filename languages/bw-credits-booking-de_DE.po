#. Booking attempt with no credits available
#: catalogue:error.no_credits
msgid "You don't have any credits left."
msgstr "Du hast kein Guthaben mehr."

#. Booking attempt for a past session
#: catalogue:error.slot_past
msgid "This session is in the past."
msgstr "Dieser Termin liegt in der Vergangenheit."

#. Duplicate booking
#: catalogue:error.already_booked
msgid "You have already booked this session."
msgstr "Du hast diesen Termin bereits gebucht."

#. Cancellation of an unknown booking
#: catalogue:error.booking_not_found
msgid "Booking not found."
msgstr "Buchung nicht gefunden."

#. Cancellation of an already-cancelled booking
#: catalogue:error.not_active
msgid "This booking has already been cancelled."
msgstr "Diese Buchung ist bereits storniert."

#. Cancellation attempt after the deadline
#: catalogue:error.cutoff_passed
msgid "The cancellation deadline has passed."
msgstr "Die Stornofrist ist abgelaufen."

#. Session is missing or not published
#: catalogue:error.slot_invalid
msgid "This session is not available."
msgstr "Dieser Termin ist nicht verfügbar."

#. Capacity is missing or zero
#: catalogue:error.capacity_missing
msgid "No capacity is set for this session."
msgstr "Für diesen Termin ist keine Kapazität hinterlegt."

#. start_datetime not set
#: catalogue:error.slot_time_missing
msgid "This session is missing a start time."
msgstr "Für diesen Termin fehlt die Startzeit."

#. Concurrent access, retry needed
#: catalogue:error.retry
msgid "That didn't work. Please try again."
msgstr "Das hat nicht geklappt. Bitte versuche es noch einmal."

#. Unexpected error while booking or cancelling
#: catalogue:error.generic
msgid "The action could not be completed."
msgstr "Die Aktion konnte nicht ausgeführt werden."

#. Heading in the WooCommerce order email when credits were added
#: catalogue:order_email.heading
msgid "Your credit balance has been topped up"
msgstr "Dein Guthaben wurde aufgeladen"

#. Text in the WooCommerce order email, right after the order summary
#: catalogue:order_email.body
msgid "{credits_added} credits have been added to your account. Current balance: {credits_remaining}.\n\nManage your credits and bookings here: {account_link}"
msgstr "{credits_added} Credits wurden deinem Konto gutgeschrieben. Aktuelles Guthaben: {credits_remaining}.\n\nHier verwaltest du dein Guthaben und deine Buchungen: {account_link}"

